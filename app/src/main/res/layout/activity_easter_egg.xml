<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- SurfaceView for the video - more reliable than VideoView -->
    <SurfaceView
        android:id="@+id/egg_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Shown instead of egg_surface when the user's UI-customization pick
         (see UserMediaResolver) is an image or GIF rather than a video. -->
    <ImageView
        android:id="@+id/egg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- No longer shown in normal use — UserMediaResolver always resolves to
         either the person's override or a bundled default now, so there's
         no "nothing to show" case anymore. Left in place, defaulting to
         gone, only as a defensive fallback. -->
    <TextView
        android:id="@+id/egg_no_media_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="@string/easter_egg_no_media"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/egg_hint_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="@string/tap_anywhere_to_exit"
        android:textSize="13sp"
        android:textColor="#66FFFFFF"
        android:alpha="0"
        android:fontFamily="sans-serif-light" />

</FrameLayout>

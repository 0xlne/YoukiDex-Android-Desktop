<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ══════ The notifications area ══════ -->
    <LinearLayout
        android:id="@+id/notification_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/round_rect"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notifications"
                android:tint="#CCFFFFFF"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notifications"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/cancel_all_n_btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_notification_clear_all"
                android:tint="#CCFFFFFF"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#22FFFFFF"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notification_lv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fadingEdgeLength="8dp"
            android:requiresFadingEdge="vertical"/>

    </LinearLayout>

    <!-- ══════ The Quick Settings area (merged with notifications) ══════ -->
    <LinearLayout
        android:id="@+id/qs_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/round_rect"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- ── The sliders row: volume + brightness ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/volume_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle"
                android:padding="7dp"
                android:src="@drawable/ic_audio_music" />

            <SeekBar
                android:id="@+id/volume_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brightness_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle"
                android:padding="7dp"
                android:src="@drawable/ic_brightness" />

            <SeekBar
                android:id="@+id/brightness_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- ── The tiles row: WiFi + Bluetooth ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/wifi_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/search_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/wifi_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/circle"
                    android:padding="9dp"
                    android:src="@drawable/ic_wifi_on" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wi_fi"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/wifi_ssid_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bluetooth_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/search_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/bluetooth_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_bluetooth" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/bluetooth"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── The circular buttons row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView
                    android:id="@+id/notifications_btn"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circle" android:padding="9dp"
                    android:src="@drawable/ic_notifications"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/notifications" android:textColor="#CCFFFFFF"
                    android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView
                    android:id="@+id/btn_orientation"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circle" android:padding="9dp"
                    android:src="@drawable/ic_screen_rotation_off"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/rotation" android:textColor="#CCFFFFFF"
                    android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView
                    android:id="@+id/btn_touch_mode"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circle" android:padding="9dp"
                    android:src="@drawable/ic_touch_mode"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/touch" android:textColor="#CCFFFFFF"
                    android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView
                    android:id="@+id/btn_screenshot"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circle" android:padding="9dp"
                    android:src="@drawable/ic_screenshot"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/screenshot" android:textColor="#CCFFFFFF"
                    android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView
                    android:id="@+id/btn_screencast"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circle" android:padding="9dp"
                    android:src="@drawable/ic_screencap"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/record" android:textColor="#CCFFFFFF"
                    android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/circle" android:padding="9dp"
                    android:src="@drawable/ic_settings"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings" android:textColor="#CCFFFFFF"
                    android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>

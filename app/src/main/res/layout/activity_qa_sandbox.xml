<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- User-picked UI-customization media (image/video/GIF — see
             UserMediaResolver). No bundled default asset; falls back to
             qa_loading_spinner below when nothing's been picked, or the
             picked type is a video (video needs a real player surface, see
             QaSandboxActivity#bindLoadingMedia — this ImageView only
             handles the still-image/GIF case). -->
        <ImageView
            android:id="@+id/qa_loading_media"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/qa_loading_gif_description"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/qa_loading_video"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Fully-declarative AnimatedVectorDrawable spinner (see
             drawable/qa_loading_spinner_animated.xml) — replaces the old
             ProgressBar(indeterminate) programmatic spinner. Shown whenever
             no user media is picked, or as the fallback if a picked
             image/GIF/video fails to load. -->
        <ImageView
            android:id="@+id/qa_loading_spinner"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/qa_loading_spinner_animated"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/qa_please_wait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qa_please_wait"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qa_current_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#A9B2C3"
            android:textSize="14sp"
            android:gravity="center"
            tools:text="Checking: AdvancedPreferences.kt" />

        <TextView
            android:id="@+id/qa_progress_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#6B7385"
            android:textSize="12sp"
            tools:text="7 / 31" />

        <!-- Live running count of problems found so far this run — updated
             after every single probe result, not just at the end, so the
             person watching sees it climb in real time. -->
        <TextView
            android:id="@+id/qa_issues_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF6B6B"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="3 problems found" />

        <ProgressBar
            android:id="@+id/qa_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:progressTint="#7C93FF"
            android:max="100" />

    </LinearLayout>

</FrameLayout>

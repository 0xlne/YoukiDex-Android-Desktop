<?xml version="1.0" encoding="utf-8"?>
<!--
    Renderer onboarding step — deliberately simple: a description, the device's detected
    Vulkan capability shown as plain text, and a 3-way choice (Auto / OpenGL ES / Vulkan).
    NO live preview / NO video element here — unlike fragment_onboarding_splash_choice.xml,
    which this file otherwise borrows its overall structure/styling from. See
    OnboardingRendererChoiceFragment.kt for why a live side-by-side preview was considered
    and deliberately not built.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_tune"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_renderer_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_renderer_description"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center" />

        <!-- Plain informational text only — e.g. "Your device supports Vulkan 1.3" or
             "Vulkan not supported on this device". Populated from
             NativeBridge.nativeQueryVulkanCapabilities() in onViewCreated(), which is a
             cheap instance-only Vulkan query (no surface, no swapchain) — see
             jni_bridge.rs's nativeQueryVulkanCapabilities doc comment. -->
        <TextView
            android:id="@+id/onboarding_renderer_vulkan_info_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:gravity="center"
            tools:text="Your device supports Vulkan 1.3" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/onboarding_renderer_toggle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_renderer_auto_btn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onboarding_renderer_auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_renderer_gles_btn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onboarding_renderer_gles" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_renderer_vulkan_btn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onboarding_renderer_vulkan" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onboarding_renderer_change_later_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>

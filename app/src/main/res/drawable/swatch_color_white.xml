<?xml version="1.0" encoding="utf-8"?>
<!--
    swatch_color_white.xml — أيقونة لون حقيقية (دائرة مصمتة) لخيار "White" في
    Background Color، تستبدل الإيموجي النصي السابق (⬜).
    حد رفيع غامق (stroke) يضمن وضوح الدائرة البيضاء حتى فوق خلفية فاتحة،
    وإلا تختفي الدائرة بصرياً بدون أي حدّ يفصلها عن المحيط.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
    <stroke android:width="1dp" android:color="#33000000" />
    <size android:width="18dp" android:height="18dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Simple classic mouse-pointer arrow, white fill with a black outline so
     it stays visible over both light and dark content on the secondary
     display. Hotspot (the point that lines up with the actual (x,y)) is
     the tip, i.e. this vector's own (0,0) corner — matches how
     CursorOverlayManager positions the overlay window's top-left. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2,2 L2,18.5 L6.6,14.9 L9.4,21.5 L12.2,20.3 L9.4,13.8 L15.5,13.6 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="1.3"
        android:strokeLineJoin="round" />
</vector>

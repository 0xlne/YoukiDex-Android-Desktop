<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully-XML animated loading spinner for the QA self-test loading screen —
    replaces the previous ProgramaticView/ProgressBar(indeterminate) with a
    declarative AnimatedVectorDrawable, per the "شاشه الانتظار تتحول لملف
    XML" request. Referenced directly as android:src on an ImageView in
    activity_qa_sandbox.xml; playback is started/stopped by casting to
    Animatable in QaSandboxActivity (the standard, minimal way to drive an
    AVD — there is no way to make it autoplay from XML alone).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/qa_loading_spinner_shape">

    <target
        android:name="qa_spinner_group"
        android:animation="@animator/qa_loading_spinner_rotate" />

</animated-vector>

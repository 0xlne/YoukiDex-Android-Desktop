<?xml version="1.0" encoding="utf-8"?>
<!--
    swatch_color_black.xml — أيقونة لون حقيقية (دائرة مصمتة) لخيار "Black" في
    Background Color. تستبدل الإيموجي النصي السابق (⬛) الذي كان يرندر بشكل
    غير متّسق بين الأجهزة ويتصادم بصرياً مع لون تحديد الـ Chip (Material
    Filter Chip يستخدم لون النظام/الثيم عند التحديد، فالإيموجي الملوّن
    بداخله كان يخلق تصادم ألوان، أوضحه مع اللون الأزرق تحديداً).
    حد رفيع فاتح (stroke) يضمن وضوح الدائرة السوداء حتى فوق خلفية داكنة.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FF000000" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <size android:width="18dp" android:height="18dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Static vector shape for the QA loading spinner — a partial ring (270°
    arc) that qa_loading_spinner_animated.xml rotates continuously. Kept as
    its own file (rather than inline) because AnimatedVectorDrawable
    requires the target vector as a separate resource to attach a
    <target name="..."> animation to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="qa_spinner_root"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <group
        android:name="qa_spinner_group"
        android:pivotX="24"
        android:pivotY="24">

        <path
            android:name="qa_spinner_arc"
            android:pathData="M24,4 A20,20 0 1 1 4,24"
            android:strokeColor="#7C93FF"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent" />

    </group>

</vector>

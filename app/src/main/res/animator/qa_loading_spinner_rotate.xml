<?xml version="1.0" encoding="utf-8"?>
<!--
    Continuous 360° rotation for the QA loading spinner arc, driven purely
    by XML (AnimatedVectorDrawable + objectAnimator) — no Kotlin/Java
    animation code. repeatCount="-1" = infinite, matching the previous
    ProgressBar(indeterminate) behavior it replaces.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="rotation"
        android:valueFrom="0"
        android:valueTo="360"
        android:duration="900"
        android:repeatCount="-1"
        android:interpolator="@android:interpolator/linear" />
</set>

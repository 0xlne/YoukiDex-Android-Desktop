<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/desktop_grid_category">
        <!--
            Free-text grid-size preference — the user types any columns × rows value.
            The ListPreference with hard-coded presets was replaced with a plain
            Preference that opens a custom dialog (see DesktopPreferences.kt).
        -->
        <Preference
            android:key="desktop_grid_custom"
            android:title="@string/desktop_grid_size_title"
            android:summary="5 × 7" />
    </PreferenceCategory>
</PreferenceScreen>
